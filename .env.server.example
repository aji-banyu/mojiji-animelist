# ==============================================================
# TEMPLATE ENVIRONMENT VARIABLES PELADEN SERVER (STAGING & PRODUCTION)
# Berpasangan dengan:
#   - infra/compose/docker-compose.server.yml (Staging & Caddy Ingress)
#   - infra/compose/docker-compose.prod.yml (Production Isolated)
#
# Lokasi file rahasia di VPS (chmod 600 .env):
#   - Lingkungan Staging   : /home/aji/mojiji-staging/.env
#   - Lingkungan Production: /home/aji/mojiji-production/.env
#
# PERINGATAN: JANGAN MENYIMPAN NILAI ASLI ATAU MENG-COMMIT KE REPO!
# Nilai asli di VPS disuntikkan secara otomatis via GitHub Actions Secrets.
# ==============================================================

# Lingkungan & Runtime Node.js (staging / production)
APP_ENV=staging
NODE_ENV=production

# Database Supabase (Session Pooler IPv4 Port 5432)
# Staging: Proyek Supabase #1 | Production: Proyek Supabase #2
# Format: postgres://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgres://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Upstash Redis Cache (Batas kuota gratis: 500.000 perintah/bulan)
# Staging: prefix mojiji_staging: | Production: prefix prod:
REDIS_URL=rediss://default:<UPSTASH_PASSWORD>@<UPSTASH_ENDPOINT>.upstash.io:6379
REDIS_KEY_PREFIX=mojiji_staging:

# API Eksternal Katalog Anime/Manga
TENRAI_BASE_URL=https://api.tenrai.org/v1

# Keamanan Sesi & JWT (Hasilkan kunci acak baru via: openssl rand -hex 32)
JWT_SECRET=ganti_dengan_kunci_acak_jwt_server_baru
COOKIE_NAME=mojiji_session

# Kunci Komunikasi Internal Antar-Service (Validasi header x-internal-key)
INTERNAL_KEY=ganti_dengan_kunci_acak_internal_server_baru

# Port Microservices Internal
# Catatan Alokasi Port:
#   - Staging   : 4000 (gateway), 4001 (user), 4002 (catalog), 4003 (tracker), 4004 (interaction), 4005 (notification)
#   - Production: 5000 (gateway), 5001 (user), 5002 (catalog), 5003 (tracker), 5004 (interaction), 5005 (notification)
PORT_GATEWAY=4000
PORT_USER=4001
PORT_CATALOG=4002
PORT_TRACKER=4003
PORT_INTERACTION=4004
PORT_NOTIFICATION=4005

# Internal Service Routing URLs (dalam jaringan docker compose)
# Untuk Staging (port 4000-an):
USER_SERVICE_URL=http://user-service:4001
CATALOG_SERVICE_URL=http://catalog-service:4002
TRACKER_SERVICE_URL=http://tracker-service:4003
INTERACTION_SERVICE_URL=http://interaction-service:4004
NOTIFICATION_SERVICE_URL=http://notification-service:4005
# (Catatan: Untuk Production, sesuaikan port internal ke 5001 - 5005)

# Batas Memori Node Heap (Sesuai Aturan VPS 2 GB RAM - Plafon 96 MiB per Kontainer)
NODE_OPTIONS=--max-old-space-size=64

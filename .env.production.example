# ==============================================================
# TEMPLATE ENVIRONMENT VARIABLES PRODUCTION MOJIJI (TIKET MJ-099)
# Lokasi file rahasia di VPS: /opt/mojiji/production/.env
# Hak akses file: chmod 600 /opt/mojiji/production/.env
# Pemilik file: deploy:deploy
# PERINGATAN: JANGAN MENYIMPAN NILAI ASLI ATAU MENG-COMMIT KE REPO!
# ==============================================================

# Lingkungan & Runtime Node.js
APP_ENV=production
NODE_ENV=production

# Database Supabase Production (Session Pooler IPv4)
# Project Supabase #2 (mojiji-production) - Terpisah total dari staging
# Format: postgres://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgres://postgres.<project-ref-prod>:<PASSWORD_PROD>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Upstash Redis Cache Production (Isolasi prefix prod:)
# Kuota gratis: maksimal 500.000 perintah/bulan
REDIS_URL=rediss://default:<UPSTASH_PASSWORD_PROD>@<UPSTASH_ENDPOINT_PROD>.upstash.io:6379
REDIS_KEY_PREFIX=prod:

# API Eksternal Katalog
TENRAI_BASE_URL=https://api.tenrai.org/v1

# Keamanan Sesi & JWT Production
# Hasilkan kunci acak baru menggunakan: openssl rand -hex 32
JWT_SECRET=ganti_dengan_kunci_acak_jwt_production_baru
COOKIE_NAME=mj_session

# Kunci Komunikasi Internal Antar-Service Production
# Hasilkan kunci acak baru menggunakan: openssl rand -hex 32
INTERNAL_KEY=ganti_dengan_kunci_acak_internal_production_baru

# Port Microservices Internal (di dalam container)
PORT_GATEWAY=4000
PORT_USER=4001
PORT_CATALOG=4002
PORT_TRACKER=4003

# Internal Service Routing URLs (dalam jaringan docker compose production)
USER_SERVICE_URL=http://user-service:4001
CATALOG_SERVICE_URL=http://catalog-service:4002
TRACKER_SERVICE_URL=http://tracker-service:4003

# Batas Memori Node Heap (Sesuai Aturan VPS 1 GB RAM)
NODE_OPTIONS=--max-old-space-size=64


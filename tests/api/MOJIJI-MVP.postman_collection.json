    {
      "name": "Tracker",
      "item": [
        {
          "name": "GET List Tracker",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tracker",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tracker"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Data is an array\", function () {",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Create Tracker",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mediaType\": \"anime\",\n  \"malId\": 20,\n  \"status\": \"watching\",\n  \"progress\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tracker",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tracker"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201 or 409\", function () {",
                  "    pm.expect([201, 409]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    pm.environment.set(\"trackerId\", json.data.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Increment Progress (+1)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tracker/{{trackerId}}/increment",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tracker", "{{trackerId}}", "increment"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },

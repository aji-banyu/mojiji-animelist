# Staging Environment
staging.mojiji.web.id {
    encode gzip

    # 1. Forward API requests to API Gateway
    handle /api/* {
        reverse_proxy api-gateway:4000
    }

    # 2. Serve static Next.js export files
    handle {
        root * /srv
        try_files {path} {path}/index.html /index.html
        file_server
    }
}

# Production Environment (Milestone UTS Minggu 8 - Tiket MJ-099 & MJ-106)
mojiji.web.id {
    encode gzip

    # 1. Forward API requests to Production API Gateway
    handle /api/* {
        reverse_proxy api-gateway:4000
    }

    # 2. Serve static Next.js production build files
    handle {
        root * /srv/production/web
        try_files {path} {path}/index.html /index.html
        file_server
    }
}

# ==========================================
# TEMPLATE ENVIRONMENT VARIABLES MOJIJI
# Copy file ini menjadi .env di lokal Anda
# ==========================================

# Lingkungan aplikasi (local, staging, production)
APP_ENV=local
PORT=4001

# Database (Ganti dengan kredensial lokal Docker atau URL Supabase)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mojiji?sslmode=disable

# Cache / Redis (Ganti dengan kredensial lokal Docker atau URL Upstash)
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=mojiji_local:

# API Eksternal
TENRAI_BASE_URL=https://api.jikan.moe/v4

# Keamanan & Sesi
JWT_SECRET=ganti_dengan_rahasia_lokal_anda
COOKIE_NAME=mojiji_session

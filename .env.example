# ==========================================
# TEMPLATE ENVIRONMENT VARIABLES MOJIJI
# ==========================================

# Lingkungan aplikasi (local, staging, production)
APP_ENV=local

# Kredensial Database Postgres (Docker Lokal)
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=mojiji
# URL yang dipakai Service untuk koneksi DB (karena jalan di docker network, host-nya 'db')
DATABASE_URL=postgres://postgres:postgres@db:5432/mojiji?sslmode=disable

# Cache / Redis
REDIS_URL=redis://redis:6379
REDIS_KEY_PREFIX=mojiji_local:

# API Eksternal (Sesuai PRD: Tenrai API)
TENRAI_BASE_URL=https://api.tenrai.org/v1

# Keamanan & Sesi
JWT_SECRET=ganti_dengan_rahasia_lokal_anda
COOKIE_NAME=mojiji_session

# Port Services
PORT_GATEWAY=4000
PORT_USER=4001
PORT_CATALOG=4002
PORT_TRACKER=4003